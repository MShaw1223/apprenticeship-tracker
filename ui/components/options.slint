// Choices shared by the entry and update forms.
export global Options {
    out property <[string]> levels: ["0", "4", "5", "6", "7"];
    out property <[string]> stages: [
        "Offer Received",
        "Final Interviews",
        "Assessment Centre",
        "Online Interviews",
        "Online Assessments",
        "Applied",
        "Interest Registered",
        "No Action",
        "Not Applying",
        "Rejected: Offer Received",
        "Rejected: Final Interviews",
        "Rejected: Assessment Centre",
        "Rejected: Online Interviews",
        "Rejected: Online Assessments",
        "Rejected: Applied",
    ];
    out property <[string]> fields: [
        "Company",
        "Role",
        "Pay",
        "Area",
        "Level",
        "Grades",
        "Date Applied",
        "Close Date",
        "Stage",
        "Notes",
    ];
}
