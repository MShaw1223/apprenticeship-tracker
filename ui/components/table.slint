import { StandardTableView } from "std-widgets.slint";

export component Table inherits StandardTableView {
    min-height: 200px;
    vertical-stretch: 1;

    // Column order must match table_row in src/main.rs
    columns: [
        { title: "ID", min-width: 50px },
        { title: "Company", min-width: 120px, horizontal-stretch: 1 },
        { title: "Role", min-width: 160px, horizontal-stretch: 2 },
        { title: "Pay", min-width: 70px },
        { title: "Area", min-width: 100px, horizontal-stretch: 1 },
        { title: "Level", min-width: 60px },
        { title: "Grades", min-width: 80px },
        { title: "Applied", min-width: 90px },
        { title: "Closes", min-width: 90px },
        { title: "Stage", min-width: 160px, horizontal-stretch: 1 },
        { title: "Notes", min-width: 120px, horizontal-stretch: 2 },
    ];
}
