import { ComboBox } from "std-widgets.slint";
import { Field } from "field.slint";
import { Input } from "input.slint";
import { Options } from "options.slint";

export component UpdateForm inherits HorizontalLayout {
    in-out property <string> row-id;
    in-out property <string> field;
    in-out property <string> new-value;

    spacing: 16px;

    // fetch IDs and show Company name ?
    Field {
        label: "Listing ID";
        Input {
            input-type: number;
            text <=> root.row-id;
        }
    }

    Field {
        label: "Field";
        ComboBox {
            model: Options.fields;
            current-value <=> root.field;
            selected => {
                root.new-value = "";
            }
        }
    }

    Field {
        label: "New value";
        horizontal-stretch: 2;

        if root.field == "Level": ComboBox {
            model: Options.levels;
            current-value <=> root.new-value;
        }

        if root.field == "Stage": ComboBox {
            model: Options.stages;
            current-value <=> root.new-value;
        }

        if root.field != "Level" && root.field != "Stage": Input {
            input-type: root.field == "Pay" ? InputType.decimal : InputType.text;
            text <=> root.new-value;
        }
    }
}
