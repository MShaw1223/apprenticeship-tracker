import { Palette } from "std-widgets.slint";

export component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    vertical-stretch: 0;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        @children
    }
}
